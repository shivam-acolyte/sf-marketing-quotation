datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Service {
  id               Int             @id @default(autoincrement())
  name             String          @db.VarChar(255)
  minPrice         Decimal         @map("min_price") @db.Decimal(12, 2)
  maximumPrice     Decimal         @map("maximum_price") @db.Decimal(12, 2)
  description      String?
  salesDescription String?         @map("sales_description")
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  serviceRules     ServiceRule[]
  quotationItems   QuotationItem[]

  @@map("services")
}

model Question {
  id           Int      @id @default(autoincrement())
  question     String
  questionType String   @map("question_type") @db.VarChar(50)
  options      Json?    // e.g., ["Generate Leads", "Increase Sales"]
  required     Boolean  @default(true)
  displayOrder Int?     @map("display_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("questions")
}

model ServiceRule {
  id        Int      @id @default(autoincrement())
  serviceId Int      @map("service_id")
  condition Json     // e.g., { "field": "goals", "operator": "contains", "value": "increase_sales" }
  priority  Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_rules")
}

model Customer {
  id         String       @id @default(uuid()) @db.Uuid
  name       String       @db.VarChar(255)
  email      String       @db.VarChar(255)
  phone      String?      @db.VarChar(50)
  company    String?      @db.VarChar(255)
  createdAt  DateTime     @default(now()) @map("created_at")
  assessments Assessment[]
  quotations  Quotation[]

  @@map("customers")
}

model Assessment {
  id         String       @id @default(uuid()) @db.Uuid
  customerId String?      @map("customer_id") @db.Uuid
  answers    Json         // User responses
  aiAnalysis Json?        @map("ai_analysis") // AI strategy output
  status     String       @default("started") @db.VarChar(50)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quotations Quotation[]

  @@map("assessments")
}

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  quotationNumber String          @unique @map("quotation_number") @db.VarChar(50)
  customerId      String?         @map("customer_id") @db.Uuid
  assessmentId    String?         @map("assessment_id") @db.Uuid
  subtotal        Decimal         @db.Decimal(12, 2)
  discount        Decimal         @default(0) @db.Decimal(12, 2)
  tax             Decimal         @default(0) @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  status          String          @default("draft") @db.VarChar(50)
  validUntil      DateTime?       @map("valid_until") @db.Date
  pdfPath         String?         @map("pdf_path")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assessment      Assessment?     @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  items           QuotationItem[]

  @@map("quotations")
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId String    @map("quotation_id") @db.Uuid
  serviceId   Int?      @map("service_id")
  serviceName String    @map("service_name") @db.VarChar(255)
  description String?
  quantity    Int       @default(1)
  unitPrice   Decimal   @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal   @map("total_price") @db.Decimal(12, 2)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  service     Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@map("quotation_items")
}
